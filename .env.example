# RUNUP sniper — copy to .env and fill
# Multi-RPC failover: list primary first, rest are automatic failover (viem fallback).
RPC_URLS=https://sentry.evm-rpc.injective.network/,https://lb.drpc.org/ogrpc?network=injective&dkey=YOUR_DRPC_KEY
RPC_URL=https://sentry.evm-rpc.injective.network/
# WebSocket endpoint (instant CurveOpened/CoinLaunched trigger). Use --no-ws to disable.
WS_URL=wss://sentry.evm-ws.injective.network
CHAIN_ID=1776

# V4 LaunchpadFactory (get it from the runup.fun app once live, or from Convex catalog:get)
FACTORY=

# Target a specific coin's Market (optional; if empty, snipe auto-discovers the newest coin)
MARKET=

# One or more EVM private keys, comma-separated (0x-prefixed ok) — the SNIPER wallets.
# Optional per-wallet buy amount: KEY:AMOUNT (else falls back to AMOUNT below).
# e.g. PRIVATE_KEYS=0xKEY1:20,0xKEY2:20,0xFUNDER:440
PRIVATE_KEYS=0xYOUR_KEY_1,0xYOUR_KEY_2

# Funder wallet private key (funds the sniper wallets via src/fund.mjs). NEVER the sniper wallets.
FUNDER_KEY=

# Quote asset (USDC on mainnet) + decimals
QUOTE=0xa00C59fF5a080D2b954d0c75e46E22a0c371235a
QUOTE_DECIMALS=6

# How much quote to spend per wallet
AMOUNT=25

# Slippage tolerance in bps (3000 = 30%)
SLIPPAGE_BPS=3000

# Gas (leave blank to auto-estimate). Bump these to win the race.
MAX_FEE_GWEI=
PRIORITY_GWEI=

# Trigger tuning
POLL_MS=250
LEAD_MS=400
# Public curve opens at `opening() + OPEN_DELAY_S`. V4 founding markets: opening = founding start,
# public opens 1h later → set 3600. Non-founding market: leave 0.
OPEN_DELAY_S=0

# Safety
DRY_RUN=true
BLAST=1

# ---- New-token alerts (src/alerts.mjs) ----
# Bot token is read from TELEGRAM_BOT_TOKEN (or ~/.hermes/.env). Default target = langris DM.
TELEGRAM_CHAT_ID=782664019
ALERT_POLL_MS=15000
# MC-surge watcher (alerts.mjs): fire when a coin's market cap rises >= PCT% within WINDOW
ALERT_SURGE_PCT=25
ALERT_SURGE_WINDOW_MS=300000
ALERT_SURGE_MIN_MC=500
ALERT_SURGE_POLL_MS=30000

# buy/sell tx deadline in seconds (default 600). Set >= wait time when pre-arming a snipe early.
DEADLINE_S=7200
